<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:pages="clr-namespace:Diario.Pages"
			 x:Class="Diario.Pages.HomePage"
			 x:CompileBindings="False">

	
<StackPanel VerticalAlignment="Bottom">
		<ListBox x:Name="Elementi" ItemsSource="{Binding Entita}" SelectedItem="{Binding SelectedEntita, Mode=TwoWay}" MaxHeight="{Binding Height}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
						<TextBlock Grid.Column="0" x:Name="id" Text="{Binding Id}" />
		                <TextBlock Grid.Column="1" Text="{Binding testo}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2"  Text="{Binding data}" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	    <TextBox Text="{Binding Sstring}" TextWrapping="Wrap" AcceptsReturn="True"/>
		<Button x:Name="Leggi" Command="{Binding LeggiClicked}" />
		<Button x:Name="Modifica" Command="{Binding ModificaClicked}" />
		<Button x:Name="Inserisci" Command="{Binding InserisciClicked}" />
		<Button x:Name="Elimina" Command="{Binding EliminaClicked}" />
		</StackPanel>
</ContentPage>
